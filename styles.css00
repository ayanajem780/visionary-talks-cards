:root {
  --ink: #14213D;
  --ink-soft: #223056;
  --cream: #F7F4EC;
  --cream-dim: #EDE8DA;
  --gold: #C89B4A;
  --gold-soft: #E6CE9A;
  --teal: #1D7A63;
  --rust: #B7502C;
  --text-on-cream: #1D1B16;
  --text-muted: #5B5A52;
  --font-display: "Fraunces", serif;
  --font-body: "Manrope", sans-serif;
  --font-mono: "Space Mono", monospace;
  --radius: 14px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--cream);
  color: var(--text-on-cream);
  font-family: var(--font-body);
  line-height: 1.6;
}

img, svg { display: block; max-width: 100%; }

a { color: inherit; }

.eyebrow {
  font-family: Helvetica, Arial, sans-serif;
  font-size: 14px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #F4C542;
  margin: 0 0 14px;
}
.eyebrow-center { text-align: center; }

/* Nav */
.nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(247,244,236,0.88);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid rgba(20,33,61,0.08);
}
.nav-inner {
  max-width: 1120px;
  margin: 0 auto;
  padding: 16px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 22px;
  color: var(--ink);
}
.logo-dot { color: var(--rust); }
.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
  font-size: 14px;
  font-weight: 500;
}
.nav-links a { text-decoration: none; color: var(--text-on-cream); }
.nav-cta {
  background: var(--ink);
  color: var(--cream) !important;
  padding: 9px 18px;
  border-radius: 999px;
}

/* Buttons */
.btn {
  display: inline-block;
  text-decoration: none;
  font-weight: 700;
  font-size: 15px;
  padding: 13px 26px;
  border-radius: 999px;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn:hover { transform: translateY(-1px); }
.btn-primary { background: var(--ink); color: var(--cream); }
.btn-primary:hover { opacity: 0.9; }
.btn-ghost { background: transparent; color: var(--ink); border: 1.5px solid rgba(20,33,61,0.25); }
.btn-lg { font-size: 17px; padding: 16px 34px; }

/* Hero */
.hero { padding: 64px 24px 40px; }
.hero-inner {
  max-width: 1120px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 48px;
  align-items: center;
}
.hero-text h1 {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: clamp(34px, 4.4vw, 54px);
  line-height: 1.08;
  margin: 0 0 22px;
  color: var(--ink);
}
.hero-sub {
  font-size: 17px;
  color: var(--text-muted);
  max-width: 46ch;
  margin: 0 0 30px;
}
.hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

.hero-visual { display: flex; justify-content: center; }
.card-scene { perspective: 1400px; text-align: center; }

.card-3d {
  width: 300px;
  height: 188px;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.3, 1);
  animation: idle-spin 9s ease-in-out infinite;
  cursor: pointer;
}
.card-3d:hover, .card-3d:focus, .card-3d.flipped {
  animation-play-state: paused;
  transform: rotateY(180deg);
}
@keyframes idle-spin {
  0%, 70% { transform: rotateY(0deg); }
  85% { transform: rotateY(8deg); }
  100% { transform: rotateY(0deg); }
}

.card-face {
  position: absolute;
  inset: 0;
  border-radius: 16px;
  backface-visibility: hidden;
  padding: 22px 24px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 18px 40px rgba(20,33,61,0.22);
}
.card-front {
  background: linear-gradient(150deg, var(--ink) 0%, var(--ink-soft) 100%);
  color: var(--cream);
  border: 1px solid rgba(200,155,74,0.4);
}
.card-top { display: flex; justify-content: space-between; align-items: center; }
.card-mark { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.1em; color: var(--gold-soft); }
.card-chip { width: 30px; height: 22px; border-radius: 4px; background: linear-gradient(135deg, var(--gold) 0%, var(--gold-soft) 100%); }
.card-name { font-family: var(--font-display); font-size: 21px; margin-top: auto; }
.card-role { font-size: 12.5px; color: rgba(247,244,236,0.7); margin-top: 4px; }
.card-id { font-family: var(--font-mono); font-size: 10.5px; color: rgba(230,206,154,0.7); margin-top: 12px; letter-spacing: 0.06em; }

.card-back {
  background: var(--cream);
  color: var(--ink);
  transform: rotateY(180deg);
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px solid rgba(20,33,61,0.1);
}
.qr-mock { width: 96px; height: 96px; color: var(--ink); }
.card-scan { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; color: var(--text-muted); margin: 0; }

.card-hint { font-size: 12.5px; color: var(--text-muted); margin-top: 20px; }

/* Piliers */
.piliers { padding: 90px 24px; max-width: 1120px; margin: 0 auto; }
.piliers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 12px;
}
.pilier-card {
  background: #fff;
  border: 1px solid rgba(20,33,61,0.08);
  border-radius: var(--radius);
  padding: 30px 26px;
}
.pilier-card--accent {
  background: var(--ink);
  color: var(--cream);
  border-color: var(--ink);
}
.pilier-card--accent .pilier-label { color: var(--gold-soft); }
.pilier-card--accent p:last-child { color: rgba(247,244,236,0.75); }
.pilier-label {
  font-family: Helvetica, Arial, sans-serif;
  font-size: 13.5px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #F4C542;
  margin: 0 0 10px;
}
.pilier-card h3 {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 22px;
  margin: 0 0 10px;
}
.pilier-card p:last-child { color: var(--text-muted); font-size: 15px; margin: 0; }

/* Story */
.story { padding: 100px 24px; }
.story-inner { max-width: 720px; margin: 0 auto; }

.story-text { margin-top: 28px; }
.story-title {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: clamp(24px, 3vw, 30px);
  color: var(--ink);
  text-align: center;
  margin: 0 0 28px;
}
.story-text p {
  font-size: 16px;
  line-height: 1.75;
  color: var(--text-muted);
  margin: 0 0 20px;
}
.story-question,
.story-tagline {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 19px;
  line-height: 1.5;
  color: var(--ink);
}

/* Evenement */
.evenement { background: var(--ink); color: var(--cream); padding: 90px 24px; }
.evenement .eyebrow { color: var(--gold-soft); }
.evenement-inner { max-width: 1120px; margin: 0 auto; }
.evenement h2 { font-family: var(--font-display); font-weight: 500; font-size: clamp(28px, 3.4vw, 38px); margin: 0 0 12px; }
.evenement-sub { color: rgba(247,244,236,0.7); max-width: 56ch; margin: 0 0 40px; }

.stats-row { display: flex; gap: 48px; margin-bottom: 44px; flex-wrap: wrap; }
.stat { display: flex; flex-direction: column; }
.stat-num { font-family: var(--font-display); font-size: 40px; color: var(--gold-soft); }
.stat-label { font-size: 13px; color: rgba(247,244,236,0.65); }

.gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
.gallery-item {
  aspect-ratio: 4/3;
  border-radius: 10px;
  overflow: hidden;
  background: rgba(247,244,236,0.04);
}
.gallery-item img,
.gallery-item video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.gallery-item.placeholder {
  border: 1.5px dashed rgba(247,244,236,0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}
.gallery-item.placeholder span {
  font-family: var(--font-mono);
  font-size: 11px;
  color: rgba(247,244,236,0.45);
}
.gallery-note { margin-top: 18px; font-size: 13px; color: rgba(247,244,236,0.55); }
.gallery-note code { font-family: var(--font-mono); background: rgba(247,244,236,0.1); padding: 2px 6px; border-radius: 4px; }

/* Rejoindre */
.rejoindre { padding: 100px 24px 110px; text-align: center; max-width: 720px; margin: 0 auto; }
.rejoindre h2 { font-family: var(--font-display); font-weight: 500; font-size: clamp(28px, 3.6vw, 40px); margin: 0 0 14px; color: var(--ink); }
.rejoindre-sub { color: var(--text-muted); margin: 0 0 32px; }

/* Footer */
.footer { border-top: 1px solid rgba(20,33,61,0.1); padding: 26px 24px; }
.footer-inner {
  max-width: 1120px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  color: var(--text-muted);
}

/* Responsive */
@media (max-width: 860px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-visual { order: -1; }
  .nav-links { gap: 16px; font-size: 13px; }
  .piliers-grid { grid-template-columns: 1fr; }
  .gallery { grid-template-columns: repeat(2, 1fr); }
  .stats-row { gap: 30px; }
}

/* Section title accent (Visionary Talks & Cards / Three Pillars, One Ecosystem /
   Our Story / Our Team / The Next Chapter Is Yours to Write) — explicit safety net */
.hero-text .eyebrow,
#piliers h2.eyebrow,
#story h2.eyebrow,
#team .eyebrow,
#rejoindre .eyebrow {
  font-family: Helvetica, Arial, sans-serif;
  font-size: 14px;
  color: #F4C542;
}

@media (prefers-reduced-motion: reduce) {
  .card-3d { animation: none; }
  .btn:hover { transform: none; }
}
